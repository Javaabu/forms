{
  "name": "javaabu-forms-assets",
  "private": true,
  "description": "Build tooling for the javaabu/forms Blade components: JS behaviours, CSS and icons.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm build:css",
    "build:css": "tailwindcss -i resources/css/onu-standalone.css -o dist/onu.css --minify",
    "icons": "node scripts/icons.mjs",
    "onu-classes": "node scripts/onu-classes.mjs",
    "check": "node scripts/onu-classes.mjs --check"
  },
  "devDependencies": {
    "@javaabu/onu": "^0.2.1",
    "@tailwindcss/cli": "^4.3.4",
    "lucide-static": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  }
}
